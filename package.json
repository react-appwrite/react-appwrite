{
  "name": "workspace",
  "type": "module",
  "private": "true",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "start": "turbo run start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "1.23.0",
    "tsdown": "0.15.7",
    "turbo": "2.5.8",
    "typescript": "catalog:"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "4.1.12",
      "react": "19.2.0",
      "react-dom": "19.2.0",
      "@types/react": "19.2.0",
      "@types/react-dom": "19.2.0",
      "@types/bun": "1.3.1",
      "@types/node": "24.10.0",
      "typescript": "5.9.3"
    }
  },
  "packageManager": "bun@1.3.1"
}
